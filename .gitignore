# ==============================================================================
# Surgical AI - Git Ignore Specification
# ==============================================================================

# Data & Checkpoints Isolation
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
*.pth
*.pt
*.onnx
*.tar.gz
*.bin
*.safetensors

# External Repositories, Literature & Untracked Directories
repos/
papers/
scratch/
tools/
outputs/
report/

# C / C++ & Compiled Shared Libraries
*.so
*.dylib
*.a
*.o
.build_csrc/
build/

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.DS_Store

# Logs & Tracking
*.log
wandb/
runs/
.ipynb_checkpoints/
DSAS.ipynb
.env
*.key

# LaTeX Auxiliary Build Files
*.aux
*.out
*.synctex.gz
*.bbl
*.blg
*.fls
*.fdb_latexmk

# Heavy Experiment Frame Dumps & Visualizations
visualizations/
**/visualizations/*
results/*
**/results/*
!**/results/*.md
!**/results/*.json
result/*
**/result/*

# Unused Large Proposal Binaries & PDFs
paper/proposal/figures/
paper/proposal/*.pdf
*.pdf
!paper/report.pdf
